# Copy this file to .env and fill in your own keys.
# Used to extract structured beer-release info from search results.
ANTHROPIC_API_KEY=

# Used to search the web for brewery fresh hop announcements.
# Get a free key at https://tavily.com
TAVILY_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
FLASK_PORT=5050

# Gates the Refresh button and all management endpoints. Generate a long
# random string yourself, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real value here — this file only ever holds placeholders.
ADMIN_KEY=
