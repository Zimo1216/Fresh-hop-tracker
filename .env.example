# Copy this file to .env and fill in your own keys.
# Used to extract structured beer-release info from search results.
ANTHROPIC_API_KEY=

# Used to search the web for brewery fresh hop announcements.
# Get a free key at https://tavily.com
TAVILY_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
FLASK_PORT=5050

# Set this to "local" only in your own local .env. Leave it UNSET when
# deploying (Render, etc.) — its absence is what makes the server bind
# 0.0.0.0 instead of the unreachable 127.0.0.1.
APP_ENV=local

# Gates the Refresh button and all management endpoints. Generate a long
# random string yourself, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real value here — this file only ever holds placeholders.
ADMIN_KEY=

# Turso (remote libSQL) database — set BOTH to persist data across
# deploys/restarts on a host with an ephemeral filesystem (e.g. Render's
# free tier). Get these from the Turso CLI:
#   turso db create <name>
#   turso db show <name> --url          -> TURSO_DATABASE_URL
#   turso db tokens create <name>       -> TURSO_AUTH_TOKEN
# Leave both blank to use a local SQLite file at data/fresh_hop.db instead
# (fine for local dev; data won't survive an ephemeral host's restarts).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
